{
  "manifest_version": 3,
  "name": "Extendo",
  "version": "0.0.1",
  "description": "Extendo Chrome extension.",
  "permissions": ["commands"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Reload Extendo"
  },
  "commands": {
    "reload_extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Reload the Extendo extension"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://api.faceit.com/*", "https://www.faceit.com/*"],
      "js": ["src/utils.js", "src/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["style.css"],
      "matches": ["https://api.faceit.com/*", "https://www.faceit.com/*"]
    }
  ]
}
